# Copy to .env.local and fill in what you need. Everything is optional:
# without any key the site works fully, AI feedback falls back to self-assessment,
# and users can still add their own API key in Settings → AI feedback.

# ---------------------------------------------------------------------------
# AI feedback (writing correction, speaking feedback, conversation partner)
# Set ONE provider key. With several, AI_PROVIDER picks the one to use.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Any OpenAI-compatible server (OpenRouter, Mistral, Groq, Ollama, LM Studio, …)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=

# AI_PROVIDER=anthropic          # anthropic | openai | google | compatible
# AI_MODEL=claude-opus-5-5       # model for the chosen provider (defaults: claude-opus-5-5, gpt-5-mini, gemini-2.5-flash)
# AI_ALLOW_LOCAL_BASE_URL=1      # production only: allow users' base URLs in private networks (off by default, SSRF protection)

# ---------------------------------------------------------------------------
# Natural voices for the listening tasks (used by /api/tts and `bun run audio:render`)
# Users can also add their own key in Settings → Voices.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=                # OpenAI voices (shares the key above)
# ELEVENLABS_API_KEY=
# GOOGLE_TTS_API_KEY=            # Google Cloud key with the Text-to-Speech API enabled

# Public origin for sitemap, hreflang and Open Graph URLs.
# Optional on Vercel (the production domain is detected automatically); set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://bestanden.example

# Private official materials in private/ (gitignored) are only served in development.
# Set this only for a local `next start` on your own computer – never on a public deployment.
# ALLOW_PRIVATE_MATERIALS=1
